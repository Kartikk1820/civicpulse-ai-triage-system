# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# MySQL
MYSQL_DATABASE=civicpulse
MYSQL_USER=civicpulse
MYSQL_PASSWORD=civicpulse_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=db
MYSQL_PORT=3306

# Redis (Channels + Celery broker)
REDIS_URL=redis://redis:6379/0

# Groq AI (vision-based issue triage) — add your real key here, never commit it
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-4-scout-vision-preview

# CORS — the Nginx entrypoint origin(s) the Angular app is served from
CORS_ALLOWED_ORIGINS=http://localhost

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=60
